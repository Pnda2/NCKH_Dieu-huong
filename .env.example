# Network services
WIEVAC_HTTP_PORT=3001
WIEVAC_MQTT_HOST=127.0.0.1
WIEVAC_MQTT_PORT=1883
WIEVAC_FRONTEND_PORT=5173

# Dynamic D* Lite edge cost: t0 * [1 + gamma * (c/Cmax)^delta] + H
WIEVAC_FREE_WALKING_SPEED=1.2
WIEVAC_GAMMA=1.0
WIEVAC_DELTA=2.0
WIEVAC_PEOPLE_PER_SQM=2.0
WIEVAC_HAZARD_BLOCK_THRESHOLD=100
WIEVAC_SPECIFIC_FLOW_PER_METER=1.3
WIEVAC_STAIR_FLOW_FACTOR=0.65
WIEVAC_CSI_EMA_ALPHA=0.35
WIEVAC_CSI_STALE_SECONDS=8
WIEVAC_REPLAN_INTERVAL_SECONDS=1
WIEVAC_OPTIMIZER_HORIZON_SECONDS=30
WIEVAC_OPTIMIZER_TIMEOUT_SECONDS=1
WIEVAC_ROUTE_CHANGE_PENALTY=0.5
WIEVAC_MIN_ROUTE_IMPROVEMENT=0.05

# Run the device MQTT simulator from scripts/start_all.py when no hardware is present.
WIEVAC_SIMULATOR=1
